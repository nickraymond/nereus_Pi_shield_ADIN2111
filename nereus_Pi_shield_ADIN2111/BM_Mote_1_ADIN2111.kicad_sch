	(text "ADIN status LEDs (D25): D8 red = ADIN powered (ADIN_VDDIO on).\nD9 yellow-green = port 1 link/activity on ADIN pin 21 (P1_LED_1), active low;\noff until the Pi enables LED_1 over SPI. R3 keeps the P1_TX2P4_EN strap high (1.0 V p-p).\nCut JP2 to disable both LEDs (~6 mW)."
		(exclude_from_sim no)
		(at 302.26 200.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9d3e7fdb-e684-4cab-9f97-c24b2415ed3e")
	)
