	(text "MP6550 on the 5 V rail (5V_PI). R48 sets the current limit and the VISEN scale:\nlimit = 0.5 V / (100 µA/A x 4.02 kΩ) = 1.24 A; VISEN = 0.402 V/A (MP6550 Rev. 1.0, p. 11).\n"
		(exclude_from_sim no)
		(at 54.31 74.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "624ac630-bc18-4052-a250-26d860186903")
	)
	(text "ADS1115 on shield 3V3, bus I2C0, address 0x48 (ADDR to GND through R50).\nAIN0 = MP6550 VISEN, AIN1 = pot wiper (J8), AIN2 / AIN3 unused.\nJ8: 1 = 3V3, 2 = wiper, 3 = GND (assumed order)."
		(exclude_from_sim no)
		(at 41.48 175.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "79e30ce9-8e73-4f83-a158-b7ba78cbbb8d")
	)
	(text "JST-GH pins rated for 1A"
