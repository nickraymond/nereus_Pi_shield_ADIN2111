(version 1)
   (rule "BM data pairs matched"
     (condition "A.inDiffPair('*DATA*')")
     (constraint skew (max 0.5mm)))

   (rule "JLC through-hole pad: hole to copper"
     (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
     (constraint hole_clearance (min 0.3mm)))
   (rule "JLC pad hole to pad hole"
     (condition "A.Type == 'Pad' && B.Type == 'Pad'")
     (constraint hole_to_hole (min 0.45mm)))

   (rule "Insert hole to other copper"
     (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && A.memberOfFootprint('MP?')")
     (constraint hole_clearance (min 0.2mm)))
   (rule "Insert hole to its own ring pad"
     (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && A.memberOfFootprint('MP?') && B.Type == 'Pad' && B.memberOfFootprint('MP?')")
     (constraint hole_clearance (min 0mm)))

   # --- added by the JLC rule audit of 2026-11-16 (source: https://jlcpcb.com/capabilities/pcb-capabilities) ---
   # JLC "PTH annular ring >=0.20mm ... Multilayer: 1 oz: Recommended 0.20 mm or above; absolute minimum 0.15 mm"
   (rule "JLC PTH pad annular ring"
     (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
     (constraint annular_width (min 0.2mm)))
   # JLC "Min. Non-plated holes 0.50mm"; "Drill Diameter ... Multilayer: 0.15 - 6.3 mm"
   (rule "JLC non-plated hole size"
     (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
     (constraint hole_size (min 0.5mm) (max 6.3mm)))
   # JLC "To avoid soldermask or tin stuck in the hole, recommended PTH size>=0.5mm"; drill max 6.3 mm
   (rule "JLC plated pad hole size"
     (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
     (constraint hole_size (min 0.5mm) (max 6.3mm)))
   # JLC "SMD pad to pad clearance (different nets) 0.15mm"
   (rule "JLC SMD pad to SMD pad"
     (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'")
     (constraint clearance (min 0.15mm)))
   # JLC "Pad To Silkscreen 0.15mm"
   (rule "JLC pad to silkscreen"
     (condition "A.Type == 'Pad'")
     (constraint silk_clearance (min 0.15mm)))
